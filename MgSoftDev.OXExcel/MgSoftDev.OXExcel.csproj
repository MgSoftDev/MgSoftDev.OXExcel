<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net9.0;netstandard2.0;net48</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
	  <LangVersion>10.0</LangVersion>
	  <Authors>Miguel Fernando Garcias Salazar</Authors>
	  <Company>MgSoftDev</Company>
	  <Copyright>MgSoftDev</Copyright>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageProjectUrl>https://github.com/MgSoftDev/MgSoftDev.OXExcel</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/MgSoftDev/MgSoftDev.OXExcel</RepositoryUrl>
	  <AssemblyVersion>1.0.8</AssemblyVersion>
	  <FileVersion>1.0.8</FileVersion>
	  <Version>1.0.8</Version>
	  <PackageReleaseNotes>Excel abria el archivo avisando de que lo habia reparado, y quitaba la hoja de estilos entera, cuando el documento usaba mas de 10 colores distintos: el esquema admite como mucho 10 colores recientes (mruColors) y se escribian todos. Ademas el zoom de las vistas se escribia como 0, fuera del rango 10-400 que permite el esquema; ahora ese atributo no se escribe.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- El README del repositorio es el que se muestra en la pagina del paquete. -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.3" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
  </ItemGroup>

</Project>
