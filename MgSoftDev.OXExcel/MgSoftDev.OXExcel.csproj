<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net9.0;netstandard2.0;net48</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
	  <LangVersion>10.0</LangVersion>
	  <Authors>Miguel Fernando Garcias Salazar</Authors>
	  <Company>MgSoftDev</Company>
	  <Copyright>MgSoftDev</Copyright>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageProjectUrl>https://github.com/MgSoftDev/MgSoftDev.OXExcel</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/MgSoftDev/MgSoftDev.OXExcel</RepositoryUrl>
	  <AssemblyVersion>1.0.7</AssemblyVersion>
	  <FileVersion>1.0.7</FileVersion>
	  <Version>1.0.7</Version>
	  <PackageReleaseNotes>Las celdas combinadas, los hipervinculos y el rango declarado de la hoja (dimension) ahora son de cada hoja y no del documento. En un libro de varias hojas, las combinaciones y los hipervinculos de la primera se repetian en las siguientes -con referencias equivocadas y la URL puesta como valor de la celda- y el rango declarado iba creciendo entre hojas.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- El README del repositorio es el que se muestra en la pagina del paquete. -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.3" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
  </ItemGroup>

</Project>
